# ==============================================================================
# tak-infra Environment Configuration (Self-Hosted TAK Server 5.6)
# ==============================================================================

# Server Domain and Identification
HostedDomain=localhost
TAK_VERSION=takserver-docker-5.6-RELEASE-2
StackName=TAKServer
ORGANIZATION=TISCK
ORGANIZATIONAL_UNIT=Tactical Operations

# Port Mappings (Host)
TAK_COT_PORT=8089
TAK_WEB_PORT=8443
TAK_CERT_PORT=8446
TAK_FED_PORT=8444

# ------------------------------------------------------------------------------
# Independent PostgreSQL Database (tak-db)
# ------------------------------------------------------------------------------
POSTGRES_HOST=tak-db
POSTGRES_PORT=5432
POSTGRES_DB=takserver
POSTGRES_USER=tak
POSTGRES_PASSWORD=atakatak
# Optional: Raw JDBC connection string override (auto-generated if omitted)
# PostgresURL=postgresql://tak-db:5432/takserver

# ------------------------------------------------------------------------------
# Deployed Garage S3 Storage Integration
# ------------------------------------------------------------------------------
S3_ENABLED=true
AWS_S3_Endpoint=http://store:3900
S3_BUCKET=tak-server
AWS_S3_AccessKeyId=cloudtak-key
AWS_S3_SecretAccessKey=CHANGE_ME_TO_GARAGE_SECRET
AWS_REGION=garage
AWS_S3_ForcePathStyle=true
AWS_EC2_METADATA_DISABLED=true

# ------------------------------------------------------------------------------
# Authentik LDAP Outpost Integration (Optional)
# ------------------------------------------------------------------------------
LDAP_ENABLED=true
LDAP_HOST=identity-ldap
LDAP_PORT=389
LDAP_SECURE_URL=ldap://identity-ldap:389
LDAP_DN=dc=ldap,dc=goauthentik,dc=io
LDAP_SERVICE_USER=cn=akadmin,ou=users,dc=ldap,dc=goauthentik,dc=io
LDAP_SERVICE_USER_PASSWORD=CHANGE_ME_TO_AUTHENTIK_BOOTSTRAP_TOKEN

# ------------------------------------------------------------------------------
# TLS & Certificate Lifecycle
# ------------------------------------------------------------------------------
# Set to true only in public internet deployments with valid Route53 / DNS
ENABLE_LETSENCRYPT=false
