# ==============================================================================
# TISCK Offline Authentik Identity Configuration (.env.identity)
# ==============================================================================
# Copy this file to .env.identity or merge into your local environment.
# Generate production secrets locally with:
#   ./scripts/generate-identity-secrets.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Authentik Security Secrets
# ------------------------------------------------------------------------------
# 50+ character random string used for cryptographic signing and encryption
AUTHENTIK_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_50_CHARS_MINIMUM

# Initial administrative bootstrap password for the 'akadmin' account
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_SECURE_ADMIN_PASSWORD

# Pre-shared API token granting administrative API access for automated setup
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME_TO_SECURE_BOOTSTRAP_API_TOKEN

# ------------------------------------------------------------------------------
# Offline & Air-Gap Flags (Disable outbound telemetry and update checks)
# ------------------------------------------------------------------------------
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 13+)
# ------------------------------------------------------------------------------
# In unified mode, connects to dedicated 'authentik' logical DB on postgis container
AUTHENTIK_POSTGRESQL__HOST=postgis
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME_TO_AUTHENTIK_DB_PASSWORD

# ------------------------------------------------------------------------------
# Redis Cache & Task Broker
# ------------------------------------------------------------------------------
AUTHENTIK_REDIS__HOST=identity-cache
AUTHENTIK_REDIS__PORT=6379

# ------------------------------------------------------------------------------
# Ports & Network Binding
# ------------------------------------------------------------------------------
# Host-bound administrative / web ports (bound to 127.0.0.1 per ADR 0006)
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443
AUTHENTIK_HOST=http://localhost:9000

# Outpost image template pinned for offline container execution
AUTHENTIK_OUTPOSTS__DOCKER_IMAGE_BASE=ghcr.io/goauthentik/%(type)s:2024.12.3

# ------------------------------------------------------------------------------
# Optional LDAP Outpost Configuration (Profile: ldap)
# ------------------------------------------------------------------------------
AUTHENTIK_LDAP_PORT=389
AUTHENTIK_LDAPS_PORT=636
AUTHENTIK_LDAP_BASE_DN=dc=ldap,dc=goauthentik,dc=io
AUTHENTIK_LDAP_SERVICE_USER=cn=akadmin,ou=users,dc=ldap,dc=goauthentik,dc=io

# ------------------------------------------------------------------------------
# CloudTAK OIDC Client Linking Parameters
# ------------------------------------------------------------------------------
OIDC_ENABLED=true
OIDC_FORCED=false
OIDC_DISCOVERY_URL=http://identity-server:9000/application/o/cloudtak/.well-known/openid-configuration
# Browser-facing authorization URL (accessible to client browsers on the host)
OIDC_AUTHORIZATION_URL=http://localhost:9000/application/o/authorize/
OIDC_CLIENT_ID=cloudtak
OIDC_CLIENT_SECRET=CHANGE_ME_TO_OIDC_CLIENT_SECRET
OIDC_SCOPES=openid profile email groups
OIDC_REDIRECT_URI=http://localhost:5000/api/login/oidc/callback
# Canonical OIDC Issuer URL (enforced during ID token validation)
OIDC_ISSUER=http://localhost:9000/application/o/cloudtak/
LOCAL_ONLY_ACCOUNTS=admin

# Authentik-specific CloudTAK attributes & API token (bypasses AWS Secrets Manager)
AUTHENTIK_URL=http://identity-server:9000
AUTHENTIK_APP_SLUG=cloudtak
AUTHENTIK_API_TOKEN=CHANGE_ME_TO_AUTHENTIK_BOOTSTRAP_TOKEN
SYNC_AUTHENTIK_ATTRIBUTES_ON_LOGIN=true
OIDC_SYSTEM_ADMIN_GROUP=CloudTAKSystemAdmin
OIDC_AGENCY_ADMIN_GROUP_PREFIX=CloudTAKAgency
