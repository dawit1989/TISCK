# ==============================================================================
# CloudTAK Local Deployment Configuration (.env)
# ==============================================================================
# Copy this file to .env and adjust the values for your local environment.
#
# Quick start:
#   cp .env.local.example .env
#   ./setup.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Settings
# ------------------------------------------------------------------------------
CLOUDTAK_Mode=docker-compose
CLOUDTAK_Server_Mode=both

# JWT Signing Secret (must be a long random string; setup.sh can generate this)
SigningSecret=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# External URL of CloudTAK API / Web Interface (as accessed from your browser or reverse proxy)
API_URL=http://localhost:5000
API_PORT=5000

# Tile server URL (internal or external)
PMTILES_URL=http://tiles:5002
TILES_PORT=5002

# Internal media service URL
CLOUDTAK_Config_media_url=http://media

# ------------------------------------------------------------------------------
# TAK Server Connection (CoT Event Router)
# ------------------------------------------------------------------------------
# WebSocket or TCP CoT endpoint of your existing TAK Server / FreeTAKServer.
# Example: wss://tak.local:8443 or wss://192.168.1.50:8446
CLOUDTAK_Hub_URL=wss://takserver.local:8443
HUB_RPC_PORT=5002

# ------------------------------------------------------------------------------
# Database Configuration (Local PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_DB=gis
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_PORT=5432
POSTGRES=postgres://docker:docker@postgis:5432/gis

# ------------------------------------------------------------------------------
# Garage / S3 Object Storage Configuration
# ------------------------------------------------------------------------------
# Connects to self-hosted Garage instance using its S3-compatible API.
AWS_REGION=garage
ASSET_BUCKET=cloudtak
AWS_S3_Endpoint=http://store:3900
AWS_S3_AccessKeyId=cloudtak-key
AWS_S3_SecretAccessKey=CHANGE_ME_TO_GARAGE_SECRET
AWS_S3_ForcePathStyle=true
AWS_EC2_METADATA_DISABLED=true

# ------------------------------------------------------------------------------
# OpenID Connect (OIDC / SSO) Configuration
# ------------------------------------------------------------------------------
# Enables SSO authentication via Cognito, Authentik, Keycloak, or any OIDC IdP.
OIDC_ENABLED=true
OIDC_FORCED=false
OIDC_DISCOVERY_URL=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_xxxxxxxxx/.well-known/openid-configuration
OIDC_CLIENT_ID=YOUR_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_OIDC_CLIENT_SECRET
OIDC_SCOPES=openid profile email groups
OIDC_REDIRECT_URI=http://localhost:5000/api/login/oidc/callback

# Accounts exempt from forced SSO redirect (can always log in locally with password)
LOCAL_ONLY_ACCOUNTS=admin

# ------------------------------------------------------------------------------
# TAK User Group Colors & Organizational Mappings (TISCK Tactical Teams)
# ------------------------------------------------------------------------------
CLOUDTAK_Config_group_Blue=Joint Operations Command
CLOUDTAK_Config_group_Red=Tactical Response Unit
CLOUDTAK_Config_group_Yellow=Medical & CASEVAC
CLOUDTAK_Config_group_White=Emergency Relief
CLOUDTAK_Config_group_Purple=Command & Staff
CLOUDTAK_Config_group_Brown=Ground Defense
CLOUDTAK_Config_group_Maroon=Field Hospital
CLOUDTAK_Config_group_Orange=Search & Rescue (SAR)
CLOUDTAK_Config_group_Teal=Maritime & Riverine
CLOUDTAK_Config_group_Green=Border Security
CLOUDTAK_Config_group_Cyan=Communications & Logistics
CLOUDTAK_Config_group_Dark_Blue=Intelligence & Recon

# Additional custom group slots:
CLOUDTAK_Config_group_Custom1=Aviation & UAS
CLOUDTAK_Config_group_Custom2=Special Operations

# ------------------------------------------------------------------------------
# Map & Viewport Defaults (Horn of Africa / Ethiopia)
# ------------------------------------------------------------------------------
# Default center: Addis Ababa (38.7578°E, 9.0222°N)
# Horn of Africa Bounding Box: [32.9°E, 3.3°N] to [48.0°E, 15.0°N]
CLOUDTAK_Config_map_center=38.7578,9.0222
CLOUDTAK_Config_map_zoom=6
CLOUDTAK_Config_map_pitch=0
CLOUDTAK_Config_map_bearing=0

# Metric system defaults
CLOUDTAK_Config_display_distance=kilometer
CLOUDTAK_Config_display_elevation=meter
CLOUDTAK_Config_display_speed=km/h
CLOUDTAK_Config_display_projection=mercator

# ------------------------------------------------------------------------------
# Data Retention Schedule (Cron format)
# ------------------------------------------------------------------------------
RETENTION_SCHEDULE=0 3 * * *

# ------------------------------------------------------------------------------
# Media Server Ports (MediaMTX)
# ------------------------------------------------------------------------------
MEDIA_PORT_API=9997
MEDIA_PORT_RTSP=8554
MEDIA_PORT_RTMP=1935
MEDIA_PORT_HLS=8888
MEDIA_PORT_SRT=8890
MEDIAMTX_LOGLEVEL=info
